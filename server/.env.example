PORT=8787

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Supabase: use the JWKS URL (https://<project>.supabase.co/auth/v1/.well-known/jwks.json)
# or, on older projects, the legacy JWT secret. One is required.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# WhatsApp Cloud API (optional; the webhook is disabled unless all four are set)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Demo account linking: "2348012345678:<supabase-user-id>,..."
WHATSAPP_LINKED_NUMBERS=
