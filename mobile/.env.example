# Supabase project (Project Settings > API). The publishable/anon key is safe to ship in the app;
# row-level security and the API server protect the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Naira Assist API (server/). Use your machine's LAN IP when testing on a phone, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
